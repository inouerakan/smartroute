{
  "expo": {
    "name": "smartroute",
    "slug": "smartroute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartroute",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Izinkan SmartRoute mengakses lokasi Anda untuk navigasi."
      },
      "icon": "./assets/expo.icon"
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.inouerakan.smartroute"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan SmartRoute mengakses lokasi Anda untuk navigasi"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f574177-4340-4ec4-bc89-07a0a8d48541"
      }
    },
    "owner": "inouerakans-team"
  }
}
